<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title == site.title %}{{ title }}{% else %}{{ title }} | {{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description | default(site.description) }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{{ ogType | default('website') }}">
  <meta property="og:title" content="{% if title == site.title %}{{ title }}{% else %}{{ title }} | {{ site.title }}{% endif %}">
  <meta property="og:description" content="{{ description | default(site.description) }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% if hero %}
  <meta property="og:image" content="{{ site.url }}/blog/images/{{ hero }}">
  <meta property="article:published_time" content="{{ date | isoDate }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ site.url }}/blog/images/{{ hero }}">
  {% else %}
  <meta name="twitter:card" content="summary">
  {% endif %}
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description | default(site.description) }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  {% include "partials/analytics.njk" %}
</head>
<body>
  {% include "partials/header.njk" %}

  <main id="main-content">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
</body>
</html>
